# Cloud Run / Console bulk upload (.env format)
# Console: Edit & deploy → Variables → often accepts KEY=VALUE paste
# CLI YAML preferred: env.cloudrun.yaml
#
# Replace REPLACE_* / YOUR_* before upload. Do NOT commit real secrets.

ASPNETCORE_ENVIRONMENT=Production
UsePostgres=true
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
ConnectionStrings__Postgres=Host=db.YOUR_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
Jwt__Issuer=sanathanam
Jwt__Audience=sanathanam-shops
Jwt__Key=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
Jwt__ExpiresMinutes=10080
Admin__Email=admin@yourdomain.com
Admin__Password=REPLACE_WITH_STRONG_PASSWORD
Cors__Origins__0=https://www.divinepetals.in
Cors__Origins__1=https://jewels.sanathanamshop.in
Cors__Origins__2=https://www.sanathanamshop.in
Msg91__AuthKey=REPLACE_MSG91_AUTH_KEY
Msg91__OtpTemplateId=REPLACE_OTP_TEMPLATE_ID
Msg91__WhatsAppNumber=REPLACE_WHATSAPP_INTEGRATED_NUMBER
Msg91__OrderTemplateName=order_details
