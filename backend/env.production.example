ASPNETCORE_ENVIRONMENT=Production
UsePostgres=true

# --- Supabase C# client (Project Settings → API) ---
# Products / orders / admin / tenants use PostgREST when both are set.
# SUPABASE_KEY = service_role / secret key on the API (never in the browser).
# Also run supabase/schema.sql once in the Supabase SQL Editor.
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
# Optional aliases also accepted:
# SUPABASE_SECRET_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# --- Postgres for EF Core (users, OTP, addresses) ---
# Prefer Session/Direct port 5432, NOT Transaction mode.
ConnectionStrings__Postgres=Host=db.YOUR_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

Jwt__Issuer=sanathanam
Jwt__Audience=sanathanam-shops
Jwt__Key=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
Jwt__ExpiresMinutes=10080

Admin__Email=admin@yourdomain.com
Admin__Password=REPLACE_WITH_STRONG_PASSWORD

Cors__Origins__0=https://www.divinepetals.in
Cors__Origins__1=https://jewels.sanathanamshop.in
Cors__Origins__2=https://www.sanathanamshop.in

Msg91__AuthKey=
Msg91__OtpTemplateId=
Msg91__WhatsAppNumber=
Msg91__OrderTemplateName=order_details
