ASPNETCORE_ENVIRONMENT=Production
UsePostgres=true

# --- Supabase C# client (Project Settings → API) ---
# Prefer service_role / secret key on the API (never in the browser).
# Run supabase/schema.sql once in the Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_KEY=

# --- Postgres for EF Core (users, OTP, addresses) ---
# Paste from Supabase → Project Settings → Database into Cloud Run only.
# Do not put real passwords in git.
ConnectionStrings__Postgres=

Jwt__Issuer=sanathanam
Jwt__Audience=sanathanam-shops
Jwt__Key=
Jwt__ExpiresMinutes=10080

Admin__Email=
Admin__Password=

Cors__Origins__0=https://www.divinepetals.in
Cors__Origins__1=https://divinepetals.in
Cors__Origins__2=https://www.sanathanamshop.in
Cors__Origins__3=https://sanathanamshop.in
Cors__Origins__4=https://jewels.sanathanamshop.in

Otp__StaticCode=12345
Otp__SkipSend=true

Msg91__AuthKey=
Msg91__OtpTemplateId=
Msg91__WhatsAppNumber=
Msg91__OrderTemplateName=order_details
