# Cloud Run environment variables (set in Console or gcloud).
# Do NOT commit real secrets.

ASPNETCORE_ENVIRONMENT=Production
UsePostgres=true

# Supabase: Project Settings → Database → Connection string
# Prefer "Session" pooler (port 5432) or Direct connection — not Transaction mode.
# Example (URI converted to Npgsql key=value):
# ConnectionStrings__Postgres=Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__Postgres=

Jwt__Issuer=sanathanam
Jwt__Audience=sanathanam-shops
Jwt__Key=REPLACE_WITH_32+_CHAR_RANDOM_SECRET
Jwt__ExpiresMinutes=10080

Admin__Email=admin@yourdomain.com
Admin__Password=REPLACE_WITH_STRONG_PASSWORD

# Your three Netlify HTTPS origins (add more with __3, __4, …)
Cors__Origins__0=https://www.divinepetals.in
Cors__Origins__1=https://jewels.sanathanamshop.in
Cors__Origins__2=https://www.sanathanamshop.in

# MSG91 — required before real customers (SMS OTP + WhatsApp orders)
Msg91__AuthKey=
Msg91__OtpTemplateId=
# Integrated WhatsApp number from MSG91 (as shown in their dashboard)
Msg91__WhatsAppNumber=
# Must match an approved WhatsApp Utility template with 3 body vars:
#   {{1}} brand name, {{2}} order number, {{3}} items + total
Msg91__OrderTemplateName=order_details
